Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Compressione (attiva solo se in httpd.conf è caricato mod_deflate): pagine e JSON ~10 volte più leggeri.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Asset statici: il browser li tiene in cache 30 giorni. Gli URL contengono ?v=<data file>,
# quindi quando un file cambia il browser lo riscarica comunque.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|svg|png)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
